{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Calm, accessible technical documentation with blue navigation, warm reading surfaces, and minimal ornament.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.122, 0.396, 0.651],
        "hex": "#1f65a6"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.298, 0.349, 0.412],
        "hex": "#4c5969"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.078, 0.247, 0.412],
        "hex": "#143f69"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.816, 0.651, 0.231],
        "hex": "#d0a63b"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.588, 0.435, 0.086],
        "hex": "#966f16"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.953, 0.937, 0.898],
        "hex": "#f3efe5"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.067, 0.094, 0.125],
        "hex": "#111820"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-monospace",
        "fontSize": {
          "value": 0.9,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
