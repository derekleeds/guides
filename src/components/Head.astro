---
const { head, entry } = Astro.locals.starlightRoute;
const siteUrl = "https://guides.derekleeds.cloud";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = `${siteUrl}/og-image.png`;
const personId = "https://derekleeds.com/#person";
const websiteId = `${siteUrl}/#website`;
const webpageId = `${pageUrl}#webpage`;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const { data } = entry;
const publishedDate = data.date instanceof Date ? data.date : undefined;
const isArticle = publishedDate !== undefined;

const sectionLabels: Record<string, string> = {
  ai: "AI and agents",
  openclaw: "Agent orchestration",
  hermes: "Hermes Agent",
  "memory-management": "Memory architecture",
  infrastructure: "Infrastructure",
  security: "Security",
};

const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems: { name: string; item: string }[] = [
  { name: "Derek's Guides", item: `${siteUrl}/` },
];

if (pathSegments[0] === "docs" && pathSegments.length > 1) {
  const section = pathSegments[1];
  breadcrumbItems.push({
    name: sectionLabels[section] ?? section,
    item: `${siteUrl}/docs/${section}/`,
  });
  if (pathSegments.length > 2) {
    breadcrumbItems.push({ name: data.title, item: pageUrl });
  }
} else if (pathSegments.length > 0) {
  breadcrumbItems.push({ name: data.title, item: pageUrl });
}

const hasBreadcrumbs = breadcrumbItems.length > 1;
const pageType =
  Astro.url.pathname === "/about/"
    ? "AboutPage"
    : Astro.url.pathname === "/docs/" ||
        (pathSegments[0] === "docs" && pathSegments.length === 2)
      ? "CollectionPage"
      : "WebPage";

const filteredHead = head.filter(
  ({ tag, attrs }) =>
    !(tag === "meta" && attrs && attrs.property === "og:type"),
);

const graph: Record<string, unknown>[] = [
  {
    "@type": "Person",
    "@id": personId,
    name: "Derek Leeds",
    url: "https://derekleeds.com/",
    sameAs: [
      "https://github.com/derekleeds",
      "https://www.linkedin.com/in/derekleeds",
    ],
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: "Derek's Guides",
    url: `${siteUrl}/`,
    description:
      "Practical guides to agent orchestration, memory architecture, MCP tooling, homelab infrastructure, and self-hosting.",
    author: { "@id": personId },
  },
  {
    "@type": pageType,
    "@id": webpageId,
    url: pageUrl,
    name: data.title,
    description: data.description,
    isPartOf: { "@id": websiteId },
    author: { "@id": personId },
    ...(hasBreadcrumbs ? { breadcrumb: { "@id": breadcrumbId } } : {}),
    ...(isArticle ? { mainEntity: { "@id": `${pageUrl}#article` } } : {}),
  },
];

if (hasBreadcrumbs) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": breadcrumbId,
    itemListElement: breadcrumbItems.map(({ name, item }, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name,
      item,
    })),
  });
}

if (publishedDate) {
  const modifiedDate =
    data.lastUpdated instanceof Date ? data.lastUpdated : publishedDate;
  graph.push({
    "@type": ["Article", "TechArticle"],
    "@id": `${pageUrl}#article`,
    headline: data.title,
    description: data.description,
    url: pageUrl,
    mainEntityOfPage: { "@id": webpageId },
    image: imageUrl,
    datePublished: publishedDate.toISOString(),
    dateModified: modifiedDate.toISOString(),
    author: { "@id": personId },
    publisher: { "@id": personId },
    isPartOf: { "@id": websiteId },
    ...(data.tags?.length ? { keywords: data.tags.join(", ") } : {}),
  });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

{
  filteredHead.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
<meta property="og:type" content={isArticle ? "article" : "website"} />
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
